# The default jungle already compiles every .mc file under the project and every
# resource under resources/, so only the per-product lines below are added.
# (:test)-annotated code in tests/ is stripped automatically unless the compiler
# is invoked with -t, so no separate test jungle is required. See
# CONTRIBUTING.md and the SDK's Jungle Reference Guide.
project.manifest = manifest.xml

# The map (MapPreviewView and its delegates, annotated (:map)) is compiled only
# for watches whose API has WatchUi.MapView; the (:nomap) stand-ins in
# LocationView are compiled for the others. Products without MapView (check:
# grep -c Toybox_WatchUi_MapView in the device's api.debug.xml is 0) override
# the base exclusion. tools/checks.py keeps this list equal to the device data.
base.excludeAnnotations = nomap

# Per product, generated by tools/devicelists.py from the device facts: the map left out where
# MapView is missing, and the launcher icon folder where the icon is not 40 px.
# devicelists begin
venu3s.excludeAnnotations = map
venu3s.resourcePath = $(venu3s.resourcePath);resources-launcher-70
venu3.excludeAnnotations = map
venu3.resourcePath = $(venu3.resourcePath);resources-launcher-70
vivoactive6.excludeAnnotations = map
vivoactive6.resourcePath = $(vivoactive6.resourcePath);resources-launcher-54
venu441mm.excludeAnnotations = map
venu441mm.resourcePath = $(venu441mm.resourcePath);resources-launcher-54
venu445mm.excludeAnnotations = map
venu445mm.resourcePath = $(venu445mm.resourcePath);resources-launcher-65
venux1.resourcePath = $(venux1.resourcePath);resources-launcher-65
fr255.excludeAnnotations = map
fr255m.excludeAnnotations = map
epix2pro42mm.resourcePath = $(epix2pro42mm.resourcePath);resources-launcher-60
marq2.resourcePath = $(marq2.resourcePath);resources-launcher-60
marq2aviator.resourcePath = $(marq2aviator.resourcePath);resources-launcher-60
descentmk343mm.resourcePath = $(descentmk343mm.resourcePath);resources-launcher-60
fenix847mm.resourcePath = $(fenix847mm.resourcePath);resources-launcher-65
fenix8pro47mm.resourcePath = $(fenix8pro47mm.resourcePath);resources-launcher-65
fenix947mm.resourcePath = $(fenix947mm.resourcePath);resources-launcher-65
fenix9pro47mm.resourcePath = $(fenix9pro47mm.resourcePath);resources-launcher-65
fr965.resourcePath = $(fr965.resourcePath);resources-launcher-65
fr970.resourcePath = $(fr970.resourcePath);resources-launcher-65
d2mach2.resourcePath = $(d2mach2.resourcePath);resources-launcher-65
d2mach2pro.resourcePath = $(d2mach2pro.resourcePath);resources-launcher-65
epix2pro51mm.resourcePath = $(epix2pro51mm.resourcePath);resources-launcher-60
descentmk351mm.resourcePath = $(descentmk351mm.resourcePath);resources-launcher-60
fr255s.excludeAnnotations = map
fr255sm.excludeAnnotations = map
vivoactive5.excludeAnnotations = map
vivoactive5.resourcePath = $(vivoactive5.resourcePath);resources-launcher-56
descentg2.excludeAnnotations = map
descentg2.resourcePath = $(descentg2.resourcePath);resources-launcher-60
