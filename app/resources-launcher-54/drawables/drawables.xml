<drawables xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">
    <!-- The launcher icon at 54x54, for every watch whose launcherIcon
         (compiler.json) is 54 px. app/monkey.jungle adds this folder to those
         watches' resource path (generated by tools/devicelists.py), and this
         LauncherIcon overrides the one in resources/drawables/ by id; without
         it the compiler warns that the 40x40 icon will be scaled, and
         tools/ciq fails a build on any warning. -->
    <bitmap id="LauncherIcon" filename="launcher_icon.svg" dithering="none" />
</drawables>
